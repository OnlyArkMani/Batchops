# Copy to .env (docker compose reads it automatically)
BATCHOPS_ADMIN_USERNAME=admin
# Leave empty to have a random password generated and printed once in the api logs.
BATCHOPS_ADMIN_PASSWORD=

# Real SMTP (defaults send to the bundled MailHog at http://localhost:8025)
EMAIL_HOST=mailhog
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_SMTP_AUTH=false
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=no-reply@batchops.local
